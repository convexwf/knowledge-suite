# Local receiver configuration for one-way knowledge store sync.
# Leave these unset on the cloud source server.
KNOWLEDGE_SYNC_SOURCE_URL=http://your-cloud-host:18765
KNOWLEDGE_SYNC_SOURCE_TOKEN=replace-with-source-token
KNOWLEDGE_SYNC_AT=19:00
KNOWLEDGE_SYNC_TIMEOUT_MS=300000
TZ=Asia/Shanghai
KNOWLEDGE_CATEGORIES=default,bot

# Feed: fetched news with AI briefings. There is no built-in schedule; trigger
# runs with `make feed-run` (cron) or let the composing agent call run_feed_prepare.
KNOWLEDGE_FEED_ENABLED=false
# Summary model for the coarse filter and point extraction. Defaults to the
# KNOWLEDGE_AI_OLLAMA_* settings; any OpenAI-compatible endpoint works.
# KNOWLEDGE_FEED_AI_BASE_URL=http://host.docker.internal:11434
# KNOWLEDGE_FEED_AI_MODEL=qwen2.5:7b
# KNOWLEDGE_FEED_AI_API_KEY=
